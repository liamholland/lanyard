{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "build cli",
			"command": "go build -o builds/ly -v ./cli/...",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new",
				"showReuseMessage": false,
				"clear": false,
				"close": true
			},
			"icon": {
				"id": "build",
				"color": "terminal.ansiGreen"
			},
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "build and start server",
			"command": "builds/ly server -v -P builds/config start",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"showReuseMessage": true,
				"clear": false,
				"close": false
			},
			"icon": {
				"id": "server",
				"color": "terminal.ansiGreen"
			},
			// this + `isBackground` lets it be used as a preLaunchTask
			"problemMatcher": {
				"fileLocation": "relative",
				"pattern": {
					"regexp": ".",
					"file": 1,
					"location": 2,
					"severity": 3,
					"code": 4,
					"message": 3
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
					"endsPattern": ".",
				}
			},
			"isBackground": true,
			"dependsOrder": "sequence",
			"dependsOn":[
				"build cli"
			]
		},
	]
}